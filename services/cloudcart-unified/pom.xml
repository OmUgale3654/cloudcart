<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.cloudcart</groupId>
        <artifactId>cloudcart-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>cloudcart-unified</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <name>cloudcart-unified</name>
    <description>CloudCart Unified Modular Cloud Runtime (Render / Koyeb / Free Tier Deployment)</description>

    <dependencies>
        <!-- CloudCart Domain Modules -->
        <dependency>
            <groupId>com.cloudcart</groupId>
            <artifactId>common-dto</artifactId>
        </dependency>
        <dependency>
            <groupId>com.cloudcart</groupId>
            <artifactId>user-service</artifactId>
            <version>${cloudcart.version}</version>
        </dependency>
        <dependency>
            <groupId>com.cloudcart</groupId>
            <artifactId>product-service</artifactId>
            <version>${cloudcart.version}</version>
        </dependency>
        <dependency>
            <groupId>com.cloudcart</groupId>
            <artifactId>inventory-service</artifactId>
            <version>${cloudcart.version}</version>
        </dependency>
        <dependency>
            <groupId>com.cloudcart</groupId>
            <artifactId>cart-service</artifactId>
            <version>${cloudcart.version}</version>
        </dependency>
        <dependency>
            <groupId>com.cloudcart</groupId>
            <artifactId>order-service</artifactId>
            <version>${cloudcart.version}</version>
        </dependency>
        <dependency>
            <groupId>com.cloudcart</groupId>
            <artifactId>payment-service</artifactId>
            <version>${cloudcart.version}</version>
        </dependency>
        <dependency>
            <groupId>com.cloudcart</groupId>
            <artifactId>notification-service</artifactId>
            <version>${cloudcart.version}</version>
        </dependency>

        <!-- Spring Boot Web & Data -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- Spring Cloud OpenFeign -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-openfeign</artifactId>
        </dependency>

        <!-- Database & Migrations -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>

        <!-- OpenAPI / Swagger 3 -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
        </dependency>

        <!-- Lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Testing -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
