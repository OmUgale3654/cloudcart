    {
      "name": "05 - Simulated Payments",
      "item": [
        {
          "name": "Process Payment (Success Token)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"orderNumber\": \"ORD-SIM-101\",\n  \"userId\": 1,\n  \"amount\": 149.99,\n  \"currency\": \"USD\",\n  \"paymentMethod\": \"CREDIT_CARD\",\n  \"paymentToken\": \"CARD_SUCCESS\",\n  \"idempotencyKey\": \"idem-key-test-01\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/payments/process",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "payments", "process"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Payment succeeds with COMPLETED status', function () {",
                  "    pm.response.to.have.status(200);",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.data.status).to.eql('COMPLETED');",
                  "    pm.environment.set('current_payment_id', json.data.id);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Process Payment (Declined Token)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"orderNumber\": \"ORD-DECLINE-01\",\n  \"userId\": 1,\n  \"amount\": 89.99,\n  \"currency\": \"USD\",\n  \"paymentMethod\": \"CREDIT_CARD\",\n  \"paymentToken\": \"CARD_DECLINED\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/payments/process",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "payments", "process"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Declined payment returns failed status or 400/402', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.success).to.be.false;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Process Refund",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"paymentId\": {{current_payment_id}},\n  \"amount\": 149.99,\n  \"reason\": \"Customer cancellation request\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/payments/refund",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "payments", "refund"]
            }
          }
        }
      ]
    },
    {
      "name": "06 - Orders & Distributed Saga Checkout",
      "item": [
        {
          "name": "Execute Checkout Saga (Success)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwt_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"shippingAddress\": \"742 Evergreen Terrace\",\n  \"shippingCity\": \"Springfield\",\n  \"shippingState\": \"OR\",\n  \"shippingPostalCode\": \"97477\",\n  \"shippingCountry\": \"USA\",\n  \"paymentMethod\": \"CREDIT_CARD\",\n  \"paymentToken\": \"CARD_SUCCESS\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/orders/checkout",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "orders", "checkout"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Checkout Saga succeeds with CONFIRMED order', function () {",
                  "    pm.response.to.have.status(200);",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.data.status).to.eql('CONFIRMED');",
                  "    pm.environment.set('current_order_number', json.data.orderNumber);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Execute Checkout Saga (Failure & Compensating Rollback)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwt_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"shippingAddress\": \"742 Evergreen Terrace\",\n  \"shippingCity\": \"Springfield\",\n  \"shippingState\": \"OR\",\n  \"shippingPostalCode\": \"97477\",\n  \"shippingCountry\": \"USA\",\n  \"paymentMethod\": \"CREDIT_CARD\",\n  \"paymentToken\": \"CARD_DECLINED\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/orders/checkout",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "orders", "checkout"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Declined checkout triggers Saga rollback and payment failure', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.success).to.be.false;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Get Customer Order History",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwt_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/orders",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "orders"]
            }
          }
        },
        {
          "name": "Get Order By Order Number",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwt_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/orders/{{current_order_number}}",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "orders", "{{current_order_number}}"]
            }
          }
        },
        {
          "name": "Cancel Order (Trigger Stock Release & Payment Refund)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwt_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/orders/{{current_order_number}}/cancel",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "orders", "{{current_order_number}}", "cancel"]
            }
          }
        }
      ]
